# Postgres
DATABASE_URL="postgresql://mnp:changeme@localhost:5432/mnp?schema=public"

# Publieke basis-URL van de site
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Discord OAuth (aanmelden met je Discord-account)
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# Mail voor inlogcodes en bevestigingen
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Modern Nerdplace <hello@modernnerdplace.nl>"

# --- Alleen nodig voor de docker-compose stacks (zie docs/deploy.md) ---

# Postgres-container
POSTGRES_USER="mnp"
POSTGRES_PASSWORD=""
POSTGRES_DB="mnp"

# Welke image en tag de productiestack draait
APP_IMAGE="mnp-meetups"
APP_TAG="latest"

# Token van de Cloudflare tunnel die modernnerdplace.nl naar deze app stuurt
CLOUDFLARE_TUNNEL_TOKEN=""

# Alleen zetten als je lokaal een andere poort wilt dan de standaard
# APP_PORT="3000"
# POSTGRES_PORT="5432"

# Optioneel: sleutel waarmee cron /api/maintenance/cleanup mag aanroepen
CRON_SECRET=""
