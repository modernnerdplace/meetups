// Modern Nerdplace meetup platform.
// Postgres + Prisma. Dit schema is het contract tussen de onderdelen: wijzig het
// alleen in overleg, want de import, de aanmeldingen en de publieke pagina's
// leunen er alle drie op.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

enum RsvpStatus {
  GOING
  WAITLIST
  CANCELLED
}

enum MemberRole {
  MEMBER
  ORGANISER
  /// Organisator die ook rollen van anderen mag wijzigen en events mag verwijderen.
  ADMIN
}

/// Iemand die zich aanmeldt. Kan inloggen via Discord of via een e-mailcode.
model Member {
  id           String     @id @default(cuid())
  email        String?    @unique
  emailVerified DateTime?
  discordId    String?    @unique
  name         String
  avatarUrl    String?
  company      String?
  role         MemberRole @default(MEMBER)
  /// Vrij tekstveld, alleen zichtbaar voor organisatoren. Denk aan allergieen.
  notes        String?

  // Profiel. Alleen zichtbaar op /nerds als profilePublic aan staat; het lid
  // kiest dat zelf. E-mail staat nooit op een profiel.
  /// Voor de url /nerds/<username>. Kleine letters, cijfers en streepjes.
  username      String?   @unique
  bio           String?
  jobTitle      String?
  websiteUrl    String?
  linkedinUrl   String?
  githubUrl     String?
  isMvp         Boolean   @default(false)
  isMct         Boolean   @default(false)
  interests     String[]  @default([])
  profilePublic Boolean   @default(false)
  /// Moment waarop het lid koos om het profiel openbaar te maken.
  profilePublicAt DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  rsvps    Rsvp[]
  sessions AuthSession[]
  speaker  Speaker?
  auditLog AuditLog[]

  @@index([profilePublic, name])
}

/// Ingelogde sessie. Cookie bevat alleen het token, nooit het lid-id.
model AuthSession {
  id        String   @id @default(cuid())
  token     String   @unique
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([memberId])
}

/// Eenmalige inlogcode per e-mail.
model LoginToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([email])
}

model Event {
  id          String      @id @default(cuid())
  slug        String      @unique
  title       String
  /// Een zin voor in het overzicht.
  summary     String?
  /// Markdown.
  description String?
  startsAt    DateTime
  endsAt      DateTime?
  status      EventStatus @default(DRAFT)

  /// Losse locatietekst. Blijft bestaan voor geimporteerde events; voor eigen
  /// events kies je liever een Venue, die vult dit dan aan.
  venueName    String?
  venueAddress String?
  venueUrl     String?
  venueId      String?
  venue        Venue?   @relation(fields: [venueId], references: [id], onDelete: SetNull)
  /// Maximaal aantal plekken. Leeg betekent geen limiet en dus geen wachtlijst.
  capacity     Int?

  coverImageUrl String?
  recordingUrl  String?

  /// Gevuld bij events die uit meetup.com zijn overgenomen.
  meetupComUrl     String?  @unique
  /// Opkomst zoals meetup.com die toonde. Alleen voor geimporteerde events:
  /// voor eigen events tel je de check-ins.
  importedAttendees Int?
  importedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions EventSession[]
  sponsors EventSponsor[]
  rsvps    Rsvp[]

  @@index([startsAt])
  @@index([status, startsAt])
  @@index([venueId])
}

/// Een sessie in het programma van een meetup: een praatje, een workshop of de
/// pauze. Sprekers hangen eraan via EventSessionSpeaker, want een sessie kan er
/// meer dan een hebben.
model EventSession {
  id        String  @id @default(cuid())
  eventId   String
  event     Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  title     String
  abstract  String?
  /// Tijden zijn optioneel: niet elk programma heeft een klok.
  startsAt  DateTime?
  endsAt    DateTime?
  /// Zaal of ruimte, bij een avond met twee tracks.
  room      String?
  slidesUrl String?
  recordingUrl String?
  /// Volgorde in het programma, laag eerst.
  position  Int     @default(0)

  speakers EventSessionSpeaker[]

  @@index([eventId, position])
}

/// Koppeling tussen een sessie en een spreker, met de volgorde waarin ze
/// genoemd worden.
model EventSessionSpeaker {
  sessionId String
  session   EventSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  speakerId String
  speaker   Speaker      @relation(fields: [speakerId], references: [id], onDelete: Cascade)
  position  Int          @default(0)

  @@id([sessionId, speakerId])
  @@index([speakerId])
}

/// Een spreker heeft een eigen pagina. Hoeft geen account te hebben.
model Speaker {
  id        String  @id @default(cuid())
  slug      String  @unique
  name      String
  bio       String?
  avatarUrl String?
  /// {"linkedin": "...", "website": "...", "mastodon": "..."}
  links     Json?

  memberId String? @unique
  member   Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  sessions EventSessionSpeaker[]
}

model Rsvp {
  id       String     @id @default(cuid())
  eventId  String
  event    Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  memberId String
  member   Member     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  status   RsvpStatus @default(GOING)

  /// Positie op de wachtlijst. Leeg zolang iemand niet op de wachtlijst staat.
  waitlistPosition Int?
  checkedInAt      DateTime?
  /// Wat het lid bij aanmelding invulde, bijvoorbeeld een dieetwens.
  note             String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, memberId])
  @@index([eventId, status])
}

/// Wie deed wat in het beheer. Alleen voor organisatoren zichtbaar. `data` bevat
/// nooit e-mailadressen of opmerkingen, alleen ids en de gewijzigde velden.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      Member?  @relation(fields: [actorId], references: [id], onDelete: SetNull)
  /// Bijvoorbeeld "event.create", "rsvp.cancel", "member.role".
  action     String
  entityType String
  entityId   String?
  /// Leesbare regel voor in het overzicht.
  summary    String
  data       Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([actorId])
}

/// Een locatie waar we te gast zijn. Losse tabel, zodat een adres maar op een
/// plek staat en een terugkerende gastheer zijn eigen pagina houdt.
model Venue {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  address   String?
  city      String?
  url       String?
  /// Praktische notities voor organisatoren: parkeren, sleutels, contactpersoon.
  /// Nooit publiek.
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events Event[]
}

/// Een sponsor: betaalt de pizza, de zaal of de opnames.
model Sponsor {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  /// Publieke url naar het logo. Zolang er geen media-opslag is, een link.
  logoUrl     String?
  url         String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  events EventSponsor[]
}

/// Welke sponsor bij welk event hoort, met wat ze deden.
model EventSponsor {
  eventId   String
  event     Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sponsorId String
  sponsor   Sponsor @relation(fields: [sponsorId], references: [id], onDelete: Cascade)
  /// Bijvoorbeeld "locatie", "pizza", "opnames".
  role      String?
  position  Int     @default(0)

  @@id([eventId, sponsorId])
  @@index([sponsorId])
}
